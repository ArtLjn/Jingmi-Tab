lColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell></UserObject><mxCell id="tag" value="&lt;b&gt;@ 快捷标签&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;固定标签 + 常访 + 近期书签&lt;/span&gt;" vertex="1" parent="paths" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="suggest" value="&lt;b&gt;请求联想&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;130 ms 防抖，丢弃过时响应&lt;/span&gt;" vertex="1" parent="paths" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="rank" value="&lt;b&gt;本机匹配&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;标题、URL、路径、正文&lt;/span&gt;" vertex="1" parent="paths" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="evidence" value="&lt;b&gt;提交后找证据&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;本机候选 · 可选 RAG 与模型&lt;/span&gt;" vertex="1" parent="paths" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="filters" value="&lt;b&gt;清