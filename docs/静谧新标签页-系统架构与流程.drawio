<diagram id="sync" name="05 RAG 同步与入库准入"><mxGraphModel adaptiveColors="none" dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1142" pageHeight="926" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="trigger" value="触发、连接与任务领取" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="136" width="1080" height="132" as="geometry"/></mxCell><mxCell id="flow" value="逐文档准入 · 分支处理" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="289" width="1080" height="555" as="geometry"/></mxCell><mxCell id="number" value="静谧新标签页  /  v1.17.0  /  05" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=14;fontStyle=1;fontColor=#486895;"><mxGeometry x="30" y="14" width="430" height="25" as="geometry"/></mxCell><mxCell id="title" value="RAG 同步与入库准入" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=32;fontStyle=1;"><mxGeometry x="30" y="40" width="1080" height="47" as="geometry"/></mxCell><mxCell id="subtitle" value="后台按文档处理持久化任务，区分同步回执、采集状态与当前文档版本。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=15;fontColor=#405674;"><mxGeometry x="30" y="88" width="1080" height="34" as="geometry"/></mxCell><mxCell id="events" value="&lt;b&gt;标记同步待办&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;收藏 / 标签 / 设置变化 · 手动同步&lt;/span&gt;" vertex="1" parent="trigger" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;后台调度&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;Alarm 唤醒，单轮处理约 18 秒&lt;/span&gt;" vertex="1" parent="trigger" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;连接及运行条件&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;账号与 RAG 可用、未暂停&lt;br&gt;自动同步开启或手动运行&lt;/span&gt;" vertex="1" parent="trigger" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="claim" value="&lt;b&gt;对账与领取&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;规范 URL 合并收藏入口&lt;br&gt;持久队列、删除优先、60 秒租约&lt;/span&gt;" vertex="1" parent="trigger" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;等待或退避&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;额度、网络、连接失败&lt;br&gt;结果未知须核验&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FCEDEF;strokeColor=#CB8B96;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="existing" value="&lt;b&gt;读取版本与旧回执&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;待核验先停止，按需补采&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;入库策略&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;按正文、私人授权、人工说明&lt;br&gt;公开站点资料、失效状态判断&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="route" value="&lt;b&gt;处理当前任务&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;过期代次或文档版本重新安排&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="hold" value="&lt;b&gt;保留或延后&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;无合格内容、条件未恢复&lt;br&gt;临时失败可保留旧正文&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FCEDEF;strokeColor=#CB8B96;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="del" value="&lt;b&gt;清理云端文档&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;最后收藏删除、私人内容排除&lt;br&gt;或符合失效清理条件&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="up" value="&lt;b&gt;入库 / 更新&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;正文、个人说明或站点资料&lt;br&gt;相同指纹与稳定元数据跳过&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="160" width="228" height="72" as="geometry"/></mxCell><UserObject id="guard" label="&lt;b&gt;代理执行远端操作&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;账号集合、配额与幂等控制&lt;/span&gt;" link="data:page/id,proxy"><mxCell vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF0E5;strokeColor=#D8A078;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="160" width="228" height="72" as="geometry"/></mxCell></UserObject><mxCell id="valid" value="&lt;b&gt;失效复核规则&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;404 相隔至少 24 小时再次观察&lt;br&gt;410 可直接判定，按开关清理&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="266" width="228" height="72" as="geometry"/></mxCell><mxCell id="receipt" value="&lt;b&gt;更新回执与任务状态&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;按当前版本保存回执&lt;br&gt;站点资料与正文分别标记&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="266" width="228" height="72" as="geometry"/></mxCell><mxCell id="stats" value="&lt;b&gt;工作台收录对账&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;总数 = 已收录 + 未收录&lt;br&gt;队列 / 失败 / 人工 / 暂停 / 待安排&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="372" width="228" height="72" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;endArrow=blockThin;endFill=1;strokeColor=#58718F;strokeWidth=1.3;fontSize=12;whiteSpace=nowrap;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="events" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-1" value="" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;endArrow=blockThin;endFill=1;strokeColor=#58718F;strokeWidth=1.3;fontSize=12;whiteSpace=nowrap;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="run" target="check"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-2" value="满足" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;endArrow=blockThin;endFill=1;strokeColor=#58718F;strokeWidth=1.3;fontSize=12;whiteSpace=nowrap;la