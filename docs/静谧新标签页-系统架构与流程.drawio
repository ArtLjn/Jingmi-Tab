t;span style='font-size:13px;color:#39516c'&gt;邀请注册或用户名密码登录&lt;/span&gt;" vertex="1" parent="acct" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;账号服务校验&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;服务端签发会话、密码不落客户端&lt;/span&gt;" vertex="1" parent="acct" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="profile" value="&lt;b&gt;切换本机账号空间&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;设置、标签、索引与图库隔离&lt;/span&gt;" vertex="1" parent="acct" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="status" value="&lt;b&gt;打开账号与备份页&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;会话状态 · 备份记录&lt;/span&gt;" vertex="1" parent="acct" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="dirty" value="&lt;b&gt;手动备份 / 自动触发&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;设置或标签变化标脏&lt;br&gt;防抖、周期调度与退避&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="collect" value="&lt;b&gt;整理配置快照&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;设置、标签及白名单元数据&lt;br&gt;脱敏并计算 SHA-256&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="choose" value="&lt;b&gt;选择备份通道&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;本机 JSON 或账号服务器&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="json" value="&lt;b&gt;导出 JSON&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;可用于后续本机导入&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="upload" value="&lt;b&gt;上传 / 拉取云端配置&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;PUT / GET /api/backup&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="db" value="&