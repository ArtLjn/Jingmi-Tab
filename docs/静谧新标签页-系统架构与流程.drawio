<diagram id="manage" name="07 书签归档、补全与体检"><mxGraphModel adaptiveColors="none" dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1142" pageHeight="788" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow" value="四个工作台能力 · 入口到结果" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="136" width="1080" height="570" as="geometry"/></mxCell><mxCell id="number" value="静谧新标签页  /  v1.17.0  /  07" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=14;fontStyle=1;fontColor=#486895;"><mxGeometry x="30" y="14" width="430" height="25" as="geometry"/></mxCell><mxCell id="title" value="书签归档、补全与体检" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=32;fontStyle=1;"><mxGeometry x="30" y="40" width="1080" height="47" as="geometry"/></mxCell><mxCell id="subtitle" value="浏览器目录是事实来源。归档只在满足条件时移动，AI 建议在用户确认后应用。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=15;fontColor=#405674;"><mxGeometry x="30" y="88" width="1080" height="34" as="geometry"/></mxCell><mxCell id="new" value="&lt;b&gt;新增 / 扫描其他书签&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;只处理收件箱直属收藏&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="en" value="&lt;b&gt;补全队列取得正文&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;可复用本机缓存，等待采集&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="browse" value="&lt;b&gt;打开书签空间&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;按原目录筛选，最新收藏优先&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="health" value="&lt;b&gt;发起书签体检&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;书签树、页面缓存及可用访问记录&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="rule" value="&lt;b&gt;是否命中确认规则？&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;仅显式记住的页面范围规则&lt;br&gt;受保护条目跳过&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="suggest" value="&lt;b&gt;生成标题 / 摘要 / 标签建议&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;AI 配置、额度、私人内容授权&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#1