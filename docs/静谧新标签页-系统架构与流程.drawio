<diagram id="answer" name="03 书签问答与证据校验"><mxGraphModel adaptiveColors="none" dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1142" pageHeight="793" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow" value="本地优先 → 按需召回 → 回答或降级" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="136" width="1080" height="575" as="geometry"/></mxCell><mxCell id="number" value="静谧新标签页  /  v1.17.0  /  03" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=14;fontStyle=1;fontColor=#486895;"><mxGeometry x="30" y="14" width="430" height="25" as="geometry"/></mxCell><mxCell id="title" value="书签问答与证据校验" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=32;fontStyle=1;"><mxGeometry x="30" y="40" width="1080" height="47" as="geometry"/></mxCell><mxCell id="subtitle" value="? 模式先找收藏入口，按查询形态决定是否扩展召回。只有符合证据规则的候选进入回答。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=15;fontColor=#405674;"><mxGeometry x="30" y="88" width="1080" height="34" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;提交问题&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;当前查询 / 取消信号&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;本机召回&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;书签文本 · 个人别名 · 编号&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="identity" value="&lt;b&gt;识别入口&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;同名入口歧义、精确地址&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="direct" value="&lt;b&gt;直达或提示补充&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;只展示对应入口及状态&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="need" value="&lt;b&gt;需要扩展召回？&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;无候选 / 问句候选较多&lt;br&gt;或较长问句且无明确入口&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="rewrite" value="&lt;b&gt;尝试 AI 改写&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;缺配置或改写失败用原查询&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="hybrid" value="&lt;b&gt;尝试云端混合检索&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;账号集合，hybrid + rerank&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF0E5;strokeColor=#D8A078;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="validate" value="&lt;b&gt;校验并映射命中&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;核对文档与当前本机书签关系&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="266" width="228" height="72" as="geometry"/></mxCell><mxCell id="fusion" value="&lt;b&gt;本机扩展召回与融合&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;按排名加权 · 保留原始候选 · 去重&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="266" width="228" height="72" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;有候选且 AI 可用？&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;无候选、无配置或远端失败可降级&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="266" width="228" height="72" as="geometry"/></mxCell><mxCell id="fallback" value="&lt;b&gt;显示候选或空状态&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;提示原因，保留可点击来源&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FCEDEF;strokeColor=#CB8B96;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="266" width="228" height="72" as="geometry"/></mxCell><mxCell id="evi" value="&lt;b&gt;筛选证据与回答&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;查找意图可先重排，支持流式输出&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="372" width="228" height="72" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;配置的模型接口&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;问题与有限候选片段&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF0E5;strokeColor=#D8A078;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="372" width="228" height="72" as="geometry"/></mxCell><mxCell id="finish" value="&lt;b&gt;校验引用并显示&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;引用来自候选，站点资料标明范围&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="478" width="228" height="72" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;endArrow=blockThin;endFill=1;strokeColor=#58718F;strokeWidth=1.3