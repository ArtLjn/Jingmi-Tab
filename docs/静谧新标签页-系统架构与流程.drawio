<diagram id="capture" name="04 书签事件与正文采集"><mxGraphModel adaptiveColors="none" dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1142" pageHeight="823" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="triggers" value="触发与调度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="136" width="1080" height="132" as="geometry"/></mxCell><mxCell id="flow" value="采集执行 · 缓存、权限和结果" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="289" width="1080" height="452" as="geometry"/></mxCell><mxCell id="number" value="静谧新标签页  /  v1.17.0  /  04" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=14;fontStyle=1;fontColor=#486895;"><mxGeometry x="30" y="14" width="430" height="25" as="geometry"/></mxCell><mxCell id="title" value="书签事件与正文采集" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=32;fontStyle=1;"><mxGeometry x="30" y="40" width="1080" height="47" as="geometry"/></mxCell><mxCell id="subtitle" value="后台公开采集与工具栏主动采集汇入本机正文，供索引、补全与同步使用。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=15;fontColor=#405674;"><mxGeometry x="30" y="88" width="1080" height="34" as="geometry"/></mxCell><mxCell id="created" value="&lt;b&gt;新增书签或网址变更&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;启动、定时、手动扫描补登记&lt;/span&gt;" vertex="1" parent="triggers" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="rebuild" value="&lt;b&gt;索引重建与对账&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;原生书签树 → 本机索引&lt;/span&gt;" vertex="1" parent="triggers" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="toolbar" value="&lt;b&gt;点击工具栏扩展图标&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;当前页须是 HTTP(S) 且已收藏&lt;/span&gt;" vertex="1" parent="triggers" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="manual" value="&lt;b&gt;后台补采 / 同步任务&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;按账号空间读取待办&lt;/span&gt;" vertex="1" parent="triggers" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;采集补全队列&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;按书签 ID 去重，租约约 60 秒&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="cache" value="&lt;b&gt;是否已有可用正文？&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;新鲜缓存优先，保留主动采集&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF5D9;strokeColor=#CB9E43;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="dom" value="&lt;b&gt;从活动页提取&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;遍历可见块 · 去重 · 覆盖说明&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="adapter" value="&lt;b&gt;公开请求和适配器&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;检查 Host 权限及每日额度&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;错误分类与重试&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;网络 / 超时 2 轮&lt;br&gt;临时服务错误最多 5 轮&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FCEDEF;strokeColor=#CB8B96;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="hold" value="&lt;b&gt;等待条件恢复&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;登录、授权、网络或额度&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FCEDEF;strokeColor=#CB8B96;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;保存页面与文档状态&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;正文、指纹、来源、覆盖范围&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="parse" value="&lt;b&gt;提取正文或公开资料&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;记录采集错误，必要时补同源首页&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="hydr" value="&lt;b&gt;本机检索与体检&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;更新索引和状态&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="266" width="228" height="72" as="geometry"/></mxCell><UserObject id="enrich" label="&lt;b&gt;唤醒归档 / AI 补全&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;受各自配置和隐私限制&lt;/span&gt;" link="data:page/id,manage"><mxCell vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=Pin