<diagram id="proxy" name="06 RAG 代理与写入账本"><mxGraphModel adaptiveColors="none" dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1142" pageHeight="830" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="request" value="请求入口 · 鉴权与隔离" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="136" width="1080" height="132" as="geometry"/></mxCell><mxCell id="flow" value="读取、写入与删除 · 事务账本和结果回传" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;swimlane;container=1;startSize=36;rounded=1;arcSize=10;swimlaneFillColor=#F8FAFE;fillColor=#E7EDF7;strokeColor=#CFDAEA;collapsible=0;align=left;spacingLeft=14;fontStyle=1;fontSize=15;pointerEvents=0;"><mxGeometry x="30" y="289" width="1080" height="459" as="geometry"/></mxCell><mxCell id="number" value="静谧新标签页  /  v1.17.0  /  06" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=14;fontStyle=1;fontColor=#486895;"><mxGeometry x="30" y="14" width="430" height="25" as="geometry"/></mxCell><mxCell id="title" value="RAG 代理与写入账本" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=32;fontStyle=1;"><mxGeometry x="30" y="40" width="1080" height="47" as="geometry"/></mxCell><mxCell id="subtitle" value="FastAPI 校验会话并强制使用该账号集合。下游 QuillRAG 与扩展分开部署。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;text;align=left;fontSize=15;fontColor=#405674;"><mxGeometry x="30" y="88" width="1080" height="34" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;扩展请求&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;Bearer 账号会话&lt;/span&gt;" vertex="1" parent="request" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;服务端校验会话&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;未登录或不可用时拒绝&lt;/span&gt;" vertex="1" parent="request" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b&gt;服务端确定集合&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;改写集合名，限制写入路由&lt;/span&gt;" vertex="1" parent="request" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="secret" value="&lt;b&gt;上游凭证&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;仅由服务端携带并转发上游&lt;/span&gt;" vertex="1" parent="request" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAE9FC;strokeColor=#9A93CC;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="read" value="&lt;b&gt;配置 / 检索 / 集合&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;配置直接返回账号能力&lt;br&gt;检索按账号集合转发&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="ing" value="&lt;b&gt;POST /ingest&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;仅文本表单，校验 doc_id&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="ledger" value="&lt;b&gt;MySQL 预留写入&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;账号 × 网页身份 × 内容指纹&lt;br&gt;事务预扣 UTC 日额度&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="remove" value="&lt;b&gt;DELETE 单篇文档&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;同账号集合，冲突返回 409&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#86A8D4;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="54" width="228" height="72" as="geometry"/></mxCell><mxCell id="cached" value="&lt;b&gt;内容相同：复用回执&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;不再调用上游入库&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="blocked" value="&lt;b&gt;429 / 409&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;额度耗尽或上次结果待核验&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FCEDEF;strokeColor=#CB8B96;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="281" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="send" value="&lt;b&gt;转发 QuillRAG&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;替换时先删旧版，再提交新正文&lt;br&gt;删除请求也须预留&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FFF0E5;strokeColor=#D8A078;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="545" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="unknown" value="&lt;b&gt;失败或回执不确定&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;保留隔离状态，等待核验&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#FCEDEF;strokeColor=#CB8B96;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="809" y="160" width="228" height="72" as="geometry"/></mxCell><mxCell id="searchout" value="&lt;b&gt;返回检索结果&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;扩展再校验并匹配本机收藏&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#162944;rounded=1;arcSize=15;strokeWidth=1.2;fillColor=#EAF7EF;strokeColor=#77AA90;fontSize=16;align=center;verticalAlign=middle;spacing=4;"><mxGeometry x="17" y="266" width="228" height="72" as="geometry"/></mxCell><mxCell id="index" value="&lt;b&gt;成功回填账本&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#39516c'&gt;确认 doc_id 和状态，返回客户端&lt;/span&gt;" vertex="1" parent="flow" style="html=1;whiteSpace=wrap;font