# 复制到服务器上的 /etc/jingmi-backup.env，权限 600。
# 不要提交真实密码到仓库。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jingmi_app
DB_PASSWORD=
DB_NAME=jingmi_newtab
# 旧版单令牌（兼容）；仅通过显式 legacy_token 并同时提供有效邀请码迁移旧账号
BACKUP_TOKEN_SHA256=
# 托管服务注册必填的邀请码，仅保存在服务器；留空关闭新注册，已有账号仍可登录
REGISTER_CODE=
SESSION_DAYS=90
# RAG 由后台代理，Key 不下发到浏览器；集合按账号自动生成，不需要在这里配置
RAG_BASE_URL=https://rag.lllcnm.cn
RAG_API_KEY=
RAG_ENABLED=1
CORS_ORIGINS=*
MAX_PAYLOAD_BYTES=2097152
RETENTION_VERSIONS=10
